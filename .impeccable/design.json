  "components": [
    {
      "name": "Point Pills",
      "kind": "nav",
      "refersTo": "point-pill",
      "description": "Altitude tabs: one pill per point, the active one filled with its point colour.",
      "html": "<div class=\"ds-pills\"><button class=\"ds-pill ds-pill-active\" style=\"--point-color:#309fcf\">Station</button><button class=\"ds-pill\" style=\"--point-color:#d866a1\">Observatoire</button><button class=\"ds-pill\" style=\"--point-color:#de9333\">Marin-Pascal</button><button class=\"ds-pill ds-pill-add\">+</button></div>",
      "css": ".ds-pills{display:flex;gap:.5rem;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif} .ds-pill{padding:.5rem .6rem;border-radius:2rem;border:1px solid var(--border,rgba(255,255,255,.08));background:transparent;color:var(--muted,#94a3b8);font-size:.62rem;text-transform:uppercase;font-weight:600;cursor:pointer;transition:all .2s} .ds-pill:hover{background:rgba(255,255,255,.05)} .ds-pill:focus-visible{outline:2px solid #38bdf8;outline-offset:2px} .ds-pill-active,.ds-pill-active:hover{background:var(--point-color);border-color:var(--point-color);color:#fff} .ds-pill-add{border-style:dashed;opacity:.6;font-size:.85rem;line-height:1} .ds-pill-add:hover{opacity:1}"
    },
    {
      "name": "Day Buttons",
      "kind": "nav",
      "refersTo": "day-button",
      "description": "Day navigation: muted initials, the active day in Bleu poudreuse with a dot.",
      "html": "<div class=\"ds-days\"><button class=\"ds-day ds-day-active\">LU<span class=\"ds-dot\"></span></button><button class=\"ds-day\">MA<span class=\"ds-dot\"></span></button><button class=\"ds-day\">ME<span class=\"ds-dot\"></span></button></div>",
      "css": ".ds-days{display:flex;gap:.3rem;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif} .ds-day{display:flex;flex-direction:column;align-items:center;gap:.3rem;padding:.5rem .8rem;min-width:40px;border:none;border-radius:.5rem;background:transparent;color:var(--muted,#94a3b8);font-size:.8rem;font-weight:600;cursor:pointer;transition:all .2s} .ds-day:hover{background:rgba(255,255,255,.05)} .ds-day:focus-visible{outline:2px solid #38bdf8;outline-offset:2px} .ds-dot{width:5px;height:5px;border-radius:50%;background:transparent} .ds-day-active{color:#38bdf8} .ds-day-active .ds-dot{background:#38bdf8}"
    },
    {
      "name": "Icon Button",
      "kind": "button",
      "refersTo": "icon-button",
      "description": "Square top-bar control (refresh, theme).",
      "html": "<button class=\"ds-icon-btn\" aria-label=\"Rafraîchir\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8M21 3v5h-5M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16M8 16H3v5\"/></svg></button>",
      "css": ".ds-icon-btn{display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:.5rem;border:1px solid var(--border,rgba(255,255,255,.08));background:rgba(30,41,59,.4);cursor:pointer;transition:all .2s} .ds-icon-btn:hover{background:rgba(255,255,255,.1)} .ds-icon-btn:focus-visible{outline:2px solid #38bdf8;outline-offset:2px}"
    },
    {
      "name": "Source Toggle",
      "kind": "custom",
      "refersTo": "source-toggle-arome",
      "description": "Cycles the global source; tinted with the current source hue (three variants shown).",
      "html": "<div class=\"ds-sources\"><button class=\"ds-src ds-src-om\"><span>Open<br>Meteo</span></button><button class=\"ds-src ds-src-arome\"><span>Arome</span></button><button class=\"ds-src ds-src-metno\"><span>Met<br>No</span></button></div>",
      "css": ".ds-sources{display:flex;gap:.6rem;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif} .ds-src{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;padding:0;border-radius:.4rem;border:1px solid rgba(255,255,255,.2);cursor:pointer;transition:all .2s ease} .ds-src span{font-size:.46rem;line-height:1.1;font-weight:700;letter-spacing:-.02em;text-transform:uppercase} .ds-src:hover{filter:brightness(1.15)} .ds-src:focus-visible{outline:2px solid #38bdf8;outline-offset:2px} .ds-src-om{background:rgba(56,189,248,.25);border-color:rgba(56,189,248,.5);color:#38bdf8} .ds-src-arome{background:rgba(168,85,247,.25);border-color:rgba(168,85,247,.5);color:#a855f7} .ds-src-metno{background:rgba(245,146,40,.25);border-color:rgba(215,111,31,.5);color:#f59f30}"
    },
    {
      "name": "Summary Bar",
      "kind": "custom",
      "refersTo": "summary-bar",
      "description": "Day totals strip: icon + figure pairs.",
      "html": "<div class=\"ds-summary\"><span class=\"ds-sum-item\"><b>-6°</b> / <b>-1°</b></span><span class=\"ds-sum-item\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#60a5fa\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M2 12h20M12 2v20M20 16l-4-4 4-4M4 8l4 4-4 4M16 4l-4 4-4-4M8 20l4-4 4 4\"/></svg><b>18 cm</b></span><span class=\"ds-sum-item ds-sum-muted\">pluie 0 mm</span></div>",
      "css": ".ds-summary{display:flex;flex-wrap:wrap;gap:1rem;padding:.45rem 1rem;min-height:40px;align-items:center;background:rgba(255,255,255,.05);border-radius:.75rem;font-size:.85rem;color:var(--text,#e5e7eb);font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif} .ds-sum-item{display:flex;align-items:center;gap:.4rem} .ds-sum-muted{color:var(--muted,#94a3b8);opacity:.6}"
    },
    {
      "name": "Weather Card",
      "kind": "card",
      "refersTo": "weather-card",
      "description": "One hour or period: time, MET.no icon, temperature, inset data block.",
      "html": "<article class=\"ds-card\"><time>Matin</time><div class=\"ds-card-icon\">❄</div><div class=\"ds-temp\">-4<span>°C</span></div><div class=\"ds-data\"><span><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#bce5c8\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2M9.6 4.6A2 2 0 1 1 11 8H2M12.6 19.4A2 2 0 1 0 14 16H2\"/></svg> NO 22 km/h</span><span><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#60a5fa\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M2 12h20M12 2v20M20 16l-4-4 4-4M4 8l4 4-4 4M16 4l-4 4-4-4M8 20l4-4 4 4\"/></svg> 6 cm <em class=\"ds-dry\">sèche</em></span></div></article>",
      "css": ".ds-card{width:150px;display:flex;flex-direction:column;align-items:center;gap:.5rem;padding:.75rem;border-radius:.75rem;background:var(--card,rgba(255,255,255,.075));color:var(--text,#e5e7eb);text-align:center;transition:transform .2s;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif} .ds-card:hover{transform:translateY(-2px);background:var(--card-hover,rgba(255,255,255,.09))} .ds-card time{font-size:.75rem;color:var(--muted,#94a3b8)} .ds-card-icon{font-size:32px;line-height:48px;height:48px;color:#e0f2fe} .ds-temp{font-size:1.4rem;font-weight:700;display:flex;align-items:flex-start} .ds-temp span{font-size:.6em;margin-top:.2rem} .ds-data{display:flex;flex-direction:column;gap:.3rem;width:100%;padding:.6rem;border-radius:.5rem;background:rgba(0,0,0,.17);font-size:.75rem;color:var(--muted,#94a3b8)} .ds-data span{display:flex;align-items:center;gap:.3em} .ds-dry{font-style:normal;font-size:.65rem;color:#93c5fd}"
    },
    {
      "name": "Show More Button",
      "kind": "button",
      "refersTo": "button-more",
      "description": "Translucent pill revealing the following hours.",
      "html": "<button class=\"ds-btn-more\">Voir heures suivantes</button>",
      "css": ".ds-btn-more{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);color:var(--text,#e5e7eb);padding:.6rem 1.2rem;border-radius:2rem;font-size:.8rem;cursor:pointer;transition:all .2s;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif} .ds-btn-more:hover{background:rgba(255,255,255,.2)} .ds-btn-more:focus-visible{outline:2px solid #38bdf8;outline-offset:2px}"
    },
    {
      "name": "Confirm Button",
      "kind": "button",
      "refersTo": "button-confirm",
      "description": "Primary modal action in Bleu poudreuse, with its cancel sibling.",
